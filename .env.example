# Discord bot credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional but recommended during development: your test server's ID.
# With this set, slash commands registered via "npm run deploy-commands"
# show up in that server within seconds instead of up to an hour.
DEV_GUILD_ID=

# The prefix for ALL public commands (moderation/admin/dev
# tools are slash-only regardless). Must be EXACTLY ONE
# character — never "/" or whitespace — or the bot refuses to
# start. Changing it here re-renders every menu and usage line.
PREFIX=>

# SQLite database file (created automatically, with migrations,
# on first boot). WAL journal files appear next to it.
DATABASE_FILE=data/syndicate.db

# Optional: where the human-readable suggestions export lives (the
# database is the authoritative store; this is just a plain-text
# mirror written on every suggestion). Defaults to
# data/suggestions.txt. Test harnesses override it with a throwaway.
SUGGESTIONS_FILE=

# Optional: your Discord user ID. If set, /bot credits you as the
# developer and shows your tag. Right-click your name in Discord
# with Developer Mode on -> "Copy User ID".
OWNER_ID=

# Comma-separated Discord USER IDs allowed to run developer/owner
# commands (like /boot restart or /boot stop). This is checked in
# code against the invoking user's ID — NOT a Discord role — because
# the bot is global across every server it's in, and a role granted
# by some other server's admin should never be able to control it.
# OWNER_ID (above) is automatically included as a developer too.
DEVELOPER_IDS=

# Optional: a channel ID (in your own server) where the bot posts
# the online/offline lifecycle announcements (🟢/🔴) plus
# attention-worthy error embeds. STRICT routing: lifecycle and
# errors come here ONLY — the raw operational feed never does.
# Leave blank to disable. Right-click a channel with Developer Mode
# on -> "Copy Channel ID".
DEV_LOG_CHANNEL_ID=

# Optional: a PRIVATE channel ID where the bot mirrors its verbose
# operational feed — every command dispatch, permission decision,
# AFK change, timer, etc. (batched, INFO-and-above, no DEBUG noise).
# STRICT routing: the raw feed comes here ONLY — lifecycle
# announcements (online/offline) never land in this channel.
# Keep this channel restricted to bot staff.
BOT_LOG_CHANNEL_ID=
